# ── Required ─────────────────────────────────────────────────────────
# Strong signing secret for JWT (min. 32 characters). Never commit real values.
JWT_SECRET=change-me-use-openssl-rand-hex-32-or-similar-min-32-chars

# ── App environment ──────────────────────────────────────────────────
# development | staging | production (aliases: prod)
# Affects cookie defaults, JSON log format, and startup checks.
APP_ENV=development

# ── HTTP cookies (refresh token) ─────────────────────────────────────
# In production, use HTTPS and COOKIE_SECURE=true (default when APP_ENV=production).
COOKIE_SECURE=false
# lax | strict | none   (none requires COOKIE_SECURE=true)
COOKIE_SAMESITE=lax

# ── Database ─────────────────────────────────────────────────────────
# SQLite (default): unset = project root marketing.db
# PostgreSQL example:
# DATABASE_URL=postgresql+psycopg2://user:password@host:5432/dbname
# Install driver: pip install psycopg2-binary
# DATABASE_URL=

# ── Data / CSV paths (optional overrides) ───────────────────────────
# ADS_REPORT_CSV_PATH=/path/to/ads_report.csv
# Tenant CSV dirs default to ./data/tenants (relative to project root)

# ── Background jobs (web process) ───────────────────────────────────
# Hourly Google Ads sync loop. Keep false on the web dyno unless you intentionally
# run sync in-process; prefer a separate worker process in production.
ENABLE_BACKGROUND_SYNC=false

# ── Reverse proxy / rate limit ───────────────────────────────────────
# Trust X-Forwarded-For for client IP (set true behind Railway/Render/nginx).
TRUST_PROXY_HEADERS=false

# Auth endpoint rate limits (in-process; per worker).
# AUTH_RATE_LIMIT_WINDOW_SEC=60
# AUTH_RATE_LIMIT_MAX=30

# ── Logging ──────────────────────────────────────────────────────────
# INFO | WARNING | ERROR — root logger after startup hooks
LOG_LEVEL=INFO
# JSON logs: 1/true forces JSON; 0/false disables; unset follows APP_ENV (JSON in prod).
# JSON_LOGS=
# SLOW_REQUEST_MS=1000

# ── Dashboard debug (avoid in production) ───────────────────────────
# DASHBOARD_CALC_DEBUG=false
